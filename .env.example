# Copy this file to .env.local (never committed) and fill in your key, then restart `npm start`.
# In production, add the same variables in Vercel → Project → Settings → Environment Variables.
OPENROUTER_API_KEY=
# Optional: models to try in order, comma-separated (free models are often busy, so the next one is tried).
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,google/gemma-4-31b-it:free
